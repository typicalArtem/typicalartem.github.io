    {
      "parameters": {
        "jsCode": "// Получаем текущую дату\nconst now = new Date();\n// Получаем дату публикации поста\nconst postDate = new Date($input.item.json.timestamp);\n\n// Проверяем, был ли пост опубликован в последние 24 часа\nconst timeDiff = now.getTime() - postDate.getTime();\nconst hoursDiff = timeDiff / (1000 * 3600);\n\n// Возвращаем результат\nreturn {\n  ...items[0].json,\n  isNew: hoursDiff <= 24,\n  hoursAgo: Math.round(hoursDiff * 100) / 100,\n  formattedDate: postDate.toLocaleString('ru-RU')\n};"
      },
      "id": "j2k3l4m5-n6o7-p8q9-r0s1-t2u3v4w5x6y7",
      "name": "Check if Post is New",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1780,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.isNew }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "k3l4m5n6-o7p8-q9r0-s1t2-u3v4w5x6y7z8",
      "name": "Filter New Posts Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        2000,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Формируем красивое сообщение для email\nconst post = items[0].json;\n\nconst emailSubject = `🚨 Новая публикация конкурента`;\n\nconst emailBody = `\n<h2>🚨 Обнаружена новая публикация конкурента!</h2>\n\n<div style=\"border: 1px solid #ddd; padding: 20px; margin: 20px 0; border-radius: 8px; background-color: #f9f9f9;\">\n  <h3>📊 Информация о публикации:</h3>\n  \n  <p><strong>👤 Аккаунт:</strong> @${post.username || 'Неизвестно'}</p>\n  <p><strong>📅 Дата публикации:</strong> ${post.formattedDate}</p>\n  <p><strong>⏰ Опубликовано:</strong> ${post.hoursAgo} часов назад</p>\n  <p><strong>📝 Тип контента:</strong> ${post.media_type}</p>\n  \n  ${post.like_count ? `<p><strong>❤️ Лайки:</strong> ${post.like_count}</p>` : ''}\n  ${post.comments_count ? `<p><strong>💬 Комментарии:</strong> ${post.comments_count}</p>` : ''}\n  \n  <hr style=\"margin: 20px 0;\">\n  \n  <h4>📄 Текст публикации:</h4>\n  <div style=\"background-color: white; padding: 15px; border-radius: 5px; border-left: 4px solid #007bff;\">\n    ${post.caption || 'Текст отсутствует'}\n  </div>\n  \n  <hr style=\"margin: 20px 0;\">\n  \n  <p><strong>🔗 Ссылка на публикацию:</strong> <a href=\"${post.permalink}\" target=\"_blank\">Открыть в Instagram</a></p>\n  \n  ${post.media_url && post.media_type === 'IMAGE' ? `\n    <div style=\"margin-top: 20px;\">\n      <h4>🖼️ Изображение:</h4>\n      <img src=\"${post.media_url}\" alt=\"Post image\" style=\"max-width: 400px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);\">\n    </div>\n  ` : ''}\n  \n  ${post.media_url && post.media_type === 'VIDEO' ? `\n    <div style=\"margin-top: 20px;\">\n      <h4>🎥 Видео:</h4>\n      <p><a href=\"${post.media_url}\" target=\"_blank\">Посмотреть видео</a></p>\n    </div>\n  ` : ''}\n</div>\n\n<p style=\"color: #666; font-size: 12px; margin-top: 30px;\">📧 Это автоматическое уведомление от системы мониторинга конкурентов</p>\n`;\n\nreturn {\n  subject: emailSubject,\n  body: emailBody,\n  competitor: post.username,\n  postUrl: post.permalink,\n  timestamp: post.timestamp\n};"
      },
