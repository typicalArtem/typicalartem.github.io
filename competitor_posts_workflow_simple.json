      "id": "h0i1j2k3-l4m5-n6o7-p8q9-r0s1t2u3v4w5",
      "name": "Get Instagram Profile Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Обрабатываем ответ от Instagram API\nconst response = items[0].json;\n\nif (!response.data || !response.data.user) {\n  throw new Error(`Профиль @${items[0].json.original_username || 'unknown'} не найден или приватный`);\n}\n\nconst user = response.data.user;\nconst posts = user.edge_owner_to_timeline_media?.edges || [];\n\n// Берем последние 5 постов\nconst recentPosts = posts.slice(0, 5).map(edge => {\n  const node = edge.node;\n  return {\n    id: node.id,\n    shortcode: node.shortcode,\n    display_url: node.display_url,\n    caption: node.edge_media_to_caption?.edges?.[0]?.node?.text || '',\n    taken_at: node.taken_at_timestamp,\n    like_count: node.edge_liked_by?.count || 0,\n    comment_count: node.edge_media_to_comment?.count || 0,\n    is_video: node.is_video,\n    username: user.username,\n    permalink: `https://www.instagram.com/p/${node.shortcode}/`,\n    original_username: items[0].json.instagram_username\n  };\n});\n\nreturn recentPosts;"
      },
      "id": "i1j2k3l4-m5n6-o7p8-q9r0-s1t2u3v4w5x6",
      "name": "Extract Posts Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Получаем текущую дату\nconst now = new Date();\n// Получаем дату публикации поста (timestamp в секундах)\nconst postDate = new Date($input.item.json.taken_at * 1000);\n\n// Проверяем, был ли пост опубликован в последние 24 часа\nconst timeDiff = now.getTime() - postDate.getTime();\nconst hoursDiff = timeDiff / (1000 * 3600);\n\n// Возвращаем результат\nreturn {\n  ...items[0].json,\n  isNew: hoursDiff <= 24,\n  hoursAgo: Math.round(hoursDiff * 100) / 100,\n  formattedDate: postDate.toLocaleString('ru-RU'),\n  timestamp: postDate.toISOString()\n};"
      },
      "id": "j2k3l4m5-n6o7-p8q9-r0s1-t2u3v4w5x6y7",
      "name": "Check if Post is New",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.isNew }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equal"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "k3l4m5n6-o7p8-q9r0-s1t2-u3v4w5x6y7z8",
      "name": "Filter New Posts Only",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        1560,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Формируем красивое сообщение для email\nconst post = items[0].json;\n\nconst emailSubject = `🚨 Новая публикация @${post.username}`;\n\nconst emailBody = `\n<div style=\"font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color: #E4405F; text-align: center; border-bottom: 2px solid #E4405F; padding-bottom: 10px;\">🚨 Новая публикация конкурента!</h2>\n\n  <div style=\"border: 1px solid #ddd; padding: 20px; margin: 20px 0; border-radius: 12px; background: linear-gradient(135deg, #f9f9f9 0%, #ffffff 100%); box-shadow: 0 4px 6px rgba(0,0,0,0.1);\">\n    <h3 style=\"color: #333; margin-top: 0;\">📊 Информация о публикации:</h3>\n    \n    <table style=\"width: 100%; border-collapse: collapse;\">\n      <tr>\n        <td style=\"padding: 8px 0; border-bottom: 1px solid #eee;\"><strong>👤 Аккаунт:</strong></td>\n        <td style=\"padding: 8px 0; border-bottom: 1px solid #eee; color: #E4405F;\">@${post.username}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; border-bottom: 1px solid #eee;\"><strong>📅 Дата публикации:</strong></td>\n        <td style=\"padding: 8px 0; border-bottom: 1px solid #eee;\">${post.formattedDate}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; border-bottom: 1px solid #eee;\"><strong>⏰ Опубликовано:</strong></td>\n        <td style=\"padding: 8px 0; border-bottom: 1px solid #eee;\">${post.hoursAgo} часов назад</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; border-bottom: 1px solid #eee;\"><strong>📝 Тип контента:</strong></td>\n        <td style=\"padding: 8px 0; border-bottom: 1px solid #eee;\">${post.is_video ? '🎥 Видео' : '📸 Изображение'}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0; border-bottom: 1px solid #eee;\"><strong>❤️ Лайки:</strong></td>\n        <td style=\"padding: 8px 0; border-bottom: 1px solid #eee; color: #e74c3c;\">${post.like_count.toLocaleString()}</td>\n      </tr>\n      <tr>\n        <td style=\"padding: 8px 0;\"><strong>💬 Комментарии:</strong></td>\n        <td style=\"padding: 8px 0; color: #3498db;\">${post.comment_count.toLocaleString()}</td>\n      </tr>\n    </table>\n    \n    <div style=\"margin: 20px 0; padding: 15px; background-color: white; border-radius: 8px; border-left: 4px solid #E4405F;\">\n      <h4 style=\"margin: 0 0 10px 0; color: #333;\">📄 Текст публикации:</h4>\n      <p style=\"margin: 0; line-height: 1.6; color: #555;\">${post.caption || '❌ Текст отсутствует'}</p>\n    </div>\n    \n    <div style=\"text-align: center; margin: 20px 0;\">\n      <a href=\"${post.permalink}\" target=\"_blank\" style=\"display: inline-block; background: linear-gradient(45deg, #f09433 0%,#e6683c 25%,#dc2743 50%,#cc2366 75%,#bc1888 100%); color: white; padding: 12px 24px; text-decoration: none; border-radius: 25px; font-weight: bold; box-shadow: 0 4px 15px rgba(0,0,0,0.2);\">🔗 Открыть в Instagram</a>\n    </div>\n    \n    <div style=\"margin-top: 20px; text-align: center;\">\n      <h4 style=\"color: #333;\">🖼️ Превью:</h4>\n      <img src=\"${post.display_url}\" alt=\"Post preview\" style=\"max-width: 100%; height: auto; border-radius: 12px; box-shadow: 0 8px 25px rgba(0,0,0,0.15);\">\n    </div>\n  </div>\n\n  <div style=\"text-align: center; margin-top: 30px; padding: 15px; background-color: #f8f9fa; border-radius: 8px;\">\n    <p style=\"color: #666; font-size: 12px; margin: 0;\">📧 Это автоматическое уведомление от системы мониторинга конкурентов</p>\n    <p style=\"color: #999; font-size: 10px; margin: 5px 0 0 0;\">Время отправки: ${new Date().toLocaleString('ru-RU')}</p>\n  </div>\n</div>\n`;\n\nreturn {\n  subject: emailSubject,\n  body: emailBody,\n  competitor: post.username,\n  postUrl: post.permalink,\n  timestamp: post.timestamp,\n  likes: post.like_count,\n  comments: post.comment_count\n};"
      },
