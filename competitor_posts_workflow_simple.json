        "message": "=<div style=\"font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto;\">\n  <h2 style=\"color: #e74c3c;\">⚠️ Ошибка при проверке конкурента</h2>\n  \n  <div style=\"background-color: #f8d7da; border: 1px solid #f5c6cb; border-radius: 8px; padding: 15px; margin: 20px 0;\">\n    <p><strong>👤 Пользователь:</strong> {{ $('Filter Valid Usernames').item.json.instagram_username || 'Неизвестно' }}</p>\n    <p><strong>❌ Ошибка:</strong> {{ $json.error?.message || $json.message || 'Неизвестная ошибка' }}</p>\n    <p><strong>🕐 Время:</strong> {{ new Date().toLocaleString('ru-RU') }}</p>\n  </div>\n  \n  <div style=\"background-color: #d1ecf1; border: 1px solid #bee5eb; border-radius: 8px; padding: 15px; margin: 20px 0;\">\n    <h4 style=\"margin-top: 0; color: #0c5460;\">💡 Возможные причины:</h4>\n    <ul style=\"margin: 0; color: #0c5460;\">\n      <li>Приватный профиль</li>\n      <li>Некорректное имя пользователя</li>\n      <li>Профиль заблокирован или удален</li>\n      <li>Превышен лимит запросов к Instagram</li>\n      <li>Изменения в API Instagram</li>\n    </ul>\n  </div>\n  \n  <p style=\"color: #666; font-size: 12px;\">Проверьте настройки и попробуйте снова позже.</p>\n</div>",
        "options": {}
